# ---- Mode: simulation | paper | live ----
TRADING_MODE=simulation

# ---- Server ----
PORT=8420
HOST=0.0.0.0

# ---- OANDA v20 (optional for simulation; required for live) ----
# Without credentials the system runs on its built-in simulated feed.
OANDA_API_KEY=
OANDA_ACCOUNT_ID=
OANDA_ENV=practice            # practice | live

# ---- Instruments (comma-separated OANDA names; default = 20 liquid symbols) ----
#WATCHLIST=EUR_USD,GBP_USD,XAU_USD,SPX500_USD,BTC_USD

# ---- Scanner ----
SCAN_INTERVAL_MS=15000
CANDLE_GRANULARITY=M5
SCANNER_MIN_CONFIDENCE=60

# ---- Decision ----
APPROVAL_THRESHOLD=70
MIN_APPROVE_VOTES=4

# ---- Risk & safety ----
RISK_PER_TRADE_PCT=0.5
MAX_OPEN_POSITIONS=5
MAX_POSITIONS_PER_SYMBOL=1
DAILY_MAX_LOSS_PCT=3
MAX_CONSECUTIVE_LOSSES=4
#DO_NOT_TRADE=USD_TRY,USD_ZAR
#ALLOWED_SESSIONS=london,newyork
NEWS_WINDOW_MINUTES=30

# ---- Paper account ----
PAPER_STARTING_BALANCE=100000

# ---- Learning ----
LEARNING_ENABLED=true
LEARNING_MAX_ADJUSTMENT=10
LEARNING_MIN_SAMPLES=5

# ---- Alerts ----
#ALERT_WEBHOOK_URL=https://hooks.example.com/kyngpyn
#ALERT_SMS_WEBHOOK_URL=https://your-twilio-function.example.com/sms
#ALERT_SMTP_URL=smtps://user%40gmail.com:app-password@smtp.gmail.com:465
#ALERT_EMAIL_TO=you@example.com

# ---- LIVE TRADING (all three required, deliberately) ----
# LIVE_TRADING_ENABLED=true
# LIVE_CONFIRMATION=I UNDERSTAND LIVE TRADING RISKS
# LIVE_MAX_UNITS=10000
